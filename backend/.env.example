# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/eduhub
DB_SSL=true

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL used in reset links / deployment setup
FRONTEND_BASE_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081,https://your-vercel-project.vercel.app

# Auth / JWT
JWT_SECRET=replace-with-a-strong-secret
EXPOSE_AUTH_DEBUG=true

# Optional Redis
REDIS_URL=redis://localhost:6379

# Email delivery
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@eduhub.local
SENDGRID_API_KEY=
RESEND_API_KEY=

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=eduhub-files

